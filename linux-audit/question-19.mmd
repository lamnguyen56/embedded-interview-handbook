flowchart TB
subgraph CAM["CAMERA INPUTS"]
F["Front camera"]:::hardware
B["Rear camera"]:::hardware
L["Left camera"]:::hardware
R["Right camera"]:::hardware
end
F --> V["Camera drivers / V4L2"]:::kernel
B --> V
L --> V
R --> V
V -->|"Timestamped buffers"| G["GStreamer capture"]:::user
G -->|"Chọn frame đồng thời"| S["Synchronize + Calibrate"]:::user
S -->|"Geometry transform"| W["Warping + Stitching / GPU"]:::kernel
W -->|"Composed frame"| D["Display / HMI"]:::good
T["Vehicle signal / reverse trigger"]:::io -.-> D
V -.->|"Sequence gap / timeout"| E["Mất camera hoặc frame stale"]:::error
S -.->|"Lệch timestamp / calibration sai"| E
W -.->|"GPU quá tải / queue tăng"| E
E --> M["Cảnh báo + recovery có kiểm soát"]:::error
style CAM fill:#171f2b,stroke:#63758c,color:#d9e6f5

classDef user fill:#192e49,stroke:#409cff,color:#eff6ff,stroke-width:2px
classDef kernel fill:#3d2a11,stroke:#f5a623,color:#fff3dd,stroke-width:2px
classDef hardware fill:#282d35,stroke:#93a2b7,color:#f3f5f8,stroke-width:1.5px
classDef build fill:#302443,stroke:#ad85ed,color:#f5eeff,stroke-width:2px
classDef good fill:#173a2b,stroke:#38cf86,color:#e6fff2,stroke-width:2px
classDef error fill:#402329,stroke:#f07683,color:#fff0f2,stroke-width:1.5px
classDef io fill:#12383d,stroke:#41c7d5,color:#e7fdff,stroke-width:2px
