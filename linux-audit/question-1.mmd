flowchart TB
subgraph U["USER SPACE"]
A["Application"]:::user -->|"read / write"| L["libc wrapper"]:::user
end
subgraph K["KERNEL SPACE"]
S["System call entry"]:::kernel -->|"Kiểm tra fd, quyền, buffer"| H["VFS / Subsystem"]:::kernel
H --> D["Driver"]:::kernel
end
L -->|"svc · chuyển mức đặc quyền"| S
S -->|"Return: dữ liệu / errno"| L
D -->|"I/O request"| HW["Hardware"]:::hardware
D -.->|"I/O timeout / hardware error"| E["Lỗi có thể trả về syscall"]:::error
S -.->|"EBADF / EFAULT / permission"| E
